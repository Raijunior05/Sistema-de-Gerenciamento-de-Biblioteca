<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.univasf.bibliotech.view.AcervoController"
            styleClass="tela-prototipo,inicial,consulta-usuario">

    <!-- CABEÇALHO -->
    <top>
        <HBox styleClass="cabecalho"
              alignment="CENTER_LEFT"
              spacing="12">

            <VBox alignment="CENTER_LEFT">
                <Label text="BiblioTech"
                       styleClass="marca-sgb,marca-pequena"/>

                <Label text="Sistema de Gerenciamento de Bibliotecas"
                       styleClass="marca-legenda,legenda-pequena"/>
            </VBox>

            <ImageView fitWidth="35"
                       fitHeight="25"
                       preserveRatio="true">
                <image>
                    <Image url="@../images/livros.png"/>
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- ÁREA PRINCIPAL -->
    <center>
    <ScrollPane hbarPolicy="NEVER"
                 vbarPolicy="AS_NEEDED"
                 fitToHeight="true"
                 fitToWidth="true"
                 pannable="false"
                 styleClass="acervo-scroll-pane">

        <StackPane alignment="TOP_CENTER">
        <VBox fx:id="painelConsulta"
              styleClass="painel,consulta-painel"
              spacing="16"
              prefWidth="1040"
              maxWidth="1100"
              alignment="TOP_CENTER">

            <Label text="P E S Q U I S A R   A C E R V O"
                   styleClass="titulo-tela"
                   alignment="CENTER"/>

            <VBox fx:id="areaBusca"
                  spacing="5"
                  maxWidth="980">

                <Label text="Título, autor, categoria, ISBN ou tombo:"
                       styleClass="rotulo-campo"/>

                <HBox alignment="CENTER"
                      spacing="0"
                      styleClass="caixa-pesquisa">

                    <TextField fx:id="campoBusca"
                               styleClass="campo-busca"
                               promptText="Digite um termo para pesquisar..."
                               onAction="#onPesquisar"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="⌕"
                            styleClass="botao-busca"
                            onAction="#onPesquisar"
                            prefWidth="45"/>
                </HBox>
            </VBox>

            <TableView fx:id="tabelaAcervo"
                       visible="false"
                       managed="false"
                       prefHeight="330"
                       maxHeight="330"
                       prefWidth="1000"
                       maxWidth="1000"
                       styleClass="tabela-consulta">

                <columns>

                    <TableColumn fx:id="colunaTombo"
                                 text="TOMBO"
                                 prefWidth="110"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaTitulo"
                                 text="TÍTULO"
                                 prefWidth="230"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaAutor"
                                 text="AUTOR"
                                 prefWidth="190"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaTipo"
                                 text="TIPO"
                                 prefWidth="100"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaCategoria"
                                 text="CATEGORIA"
                                 prefWidth="150"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaDisponibilidade"
                                 text="DISPONÍVEIS"
                                 prefWidth="110"
                                 sortable="false"/>

                    <TableColumn fx:id="colunaAcoes"
                                 text="AÇÕES"
                                 prefWidth="80"
                                 sortable="false"/>

                </columns>
            </TableView>

        </VBox>
        </StackPane>
    </ScrollPane>
</center>

    <!-- RODAPÉ -->
    <bottom>
        <HBox styleClass="rodape"
              alignment="CENTER_LEFT"
              spacing="16">

            <StackPane styleClass="perfil-circulo">
                <ImageView fitWidth="20"
                           fitHeight="20"
                           preserveRatio="true">
                    <image>
                        <Image url="@../images/perfil.png"/>
                    </image>
                </ImageView>
            </StackPane>

            <Label fx:id="rodapeNome"
                   text="Administrador"
                   styleClass="rodape-usuario"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Voltar"
                    styleClass="botao-primario"
                    onAction="#onVoltar"
                    prefWidth="140"
                    prefHeight="40"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="botao-sair"
                    onAction="#onSair">

                <graphic>
                    <ImageView fitWidth="16"
                               fitHeight="16">
                    <image>
                        <Image url="@../images/sair.png"/>
                    </image>
                </ImageView>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
