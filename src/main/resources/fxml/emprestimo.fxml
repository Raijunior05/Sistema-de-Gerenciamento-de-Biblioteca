<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.univasf.bibliotech.view.EmprestimoController"
      styleClass="tela-prototipo,login" alignment="CENTER_LEFT" spacing="40">

    <!-- Painel de Formulário (Esquerda) -->
    <AnchorPane styleClass="painel,login-painel" prefWidth="380" minWidth="380"
                prefHeight="650" minHeight="650" maxHeight="650">

        <!-- Título -->
        <Label text="REALIZAR EMPRÉSTIMO" styleClass="titulo-tela"
               layoutX="18" layoutY="16" prefWidth="344" alignment="CENTER"/>

        <!-- CU 10 passo 02: informar o item -->
        <Label text="Nome do título:" styleClass="rotulo-campo" layoutX="20" layoutY="60"/>
        <ComboBox fx:id="comboItem" promptText="Selecione um item..."
                  onAction="#onVerificarDisponibilidade"
                  layoutX="18" layoutY="80" prefWidth="344"/>

        <!-- CU 10 passo 03: resultado da verificação de disponibilidade -->
        <Label fx:id="rotuloDisponibilidade" text="Selecione o item para verificar a disponibilidade."
               styleClass="aviso-disponibilidade" wrapText="true"
               layoutX="20" layoutY="118" prefWidth="342" prefHeight="32"/>

        <!-- CU 10 passos 04 a 06: identificação do Usuário (CU 9) -->
        <Label text="CPF ou Matrícula:" styleClass="rotulo-campo" layoutX="20" layoutY="156"/>
        <TextField fx:id="campoDocumento" promptText="Digite o CPF ou a matrícula"
                   onAction="#onIdentificarUsuario" disable="true"
                   layoutX="18" layoutY="178" prefWidth="344"/>
        <Button fx:id="botaoIdentificar" text="Identificar Usuário" styleClass="botao-primario"
                onAction="#onIdentificarUsuario" disable="true"
                layoutX="18" layoutY="222" prefWidth="190" prefHeight="42"/>
        <Label fx:id="rotuloUsuarioIdentificado" text="Nenhum usuário identificado"
               styleClass="dados-usuario" wrapText="true"
               layoutX="20" layoutY="272" prefWidth="342" prefHeight="66"/>

        <!-- CU 10 passo 08: data do empréstimo registrada pelo sistema -->
        <Label text="Data de retirada:" styleClass="rotulo-campo" layoutX="20" layoutY="344"/>
        <HBox layoutX="18" layoutY="366" spacing="8" prefWidth="344">
            <VBox spacing="4">
                <Label text="Dia:" styleClass="rotulo-campo" alignment="CENTER" prefWidth="108"/>
                <TextField fx:id="campoDia" prefWidth="108" alignment="CENTER" editable="false"
                           focusTraversable="false" styleClass="campo-somente-leitura"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Mês:" styleClass="rotulo-campo" alignment="CENTER" prefWidth="108"/>
                <TextField fx:id="campoMes" prefWidth="108" alignment="CENTER" editable="false"
                           focusTraversable="false" styleClass="campo-somente-leitura"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Ano:" styleClass="rotulo-campo" alignment="CENTER" prefWidth="112"/>
                <TextField fx:id="campoAno" prefWidth="112" alignment="CENTER" editable="false"
                           focusTraversable="false" styleClass="campo-somente-leitura"/>
            </VBox>
        </HBox>

        <!-- Prazo previsto calculado pelo sistema -->
        <Label fx:id="rotuloPrazoDevolucao" text="Prazo previsto: —"
               styleClass="rotulo-campo" layoutX="20" layoutY="440" prefWidth="344"/>

        <!-- Mensagens de Erro Inline -->
        <Label fx:id="mensagemErro" styleClass="mensagem-erro" wrapText="true"
               layoutX="18" layoutY="466" prefWidth="344" prefHeight="36"/>

        <!-- CU 10 fluxo 3.1: oferta de reserva, visível só com item indisponível -->
        <Button fx:id="botaoReservar" text="Item indisponível: realizar reserva"
                styleClass="botao-menu" onAction="#onReservarItem" visible="false"
                layoutX="18" layoutY="506" prefWidth="344" prefHeight="42"/>

        <!-- Botões Cancelar e Concluído -->
        <Button text="Cancelar" styleClass="botao-menu" onAction="#onCancelar"
                layoutX="18" layoutY="560" prefWidth="155" prefHeight="46"/>
        <Button fx:id="botaoSalvar" text="Concluído" styleClass="botao-primario"
                onAction="#onSalvar" disable="true" layoutX="207" layoutY="560" prefWidth="155"
                prefHeight="46" defaultButton="true"/>
    </AnchorPane>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- Lado Direito (Marca BiblioTech e Ilustração de Livros) -->
    <VBox alignment="TOP_CENTER" spacing="4" prefWidth="330" minWidth="330" maxHeight="500">
        <Label text="BiblioTech" styleClass="marca-sgb,login-marca"/>
        <Label text="Sistema de Gerenciamento de Bibliotecas" styleClass="marca-legenda"/>
        <Region prefHeight="45"/>
        <ImageView fitWidth="405" fitHeight="260" preserveRatio="true">
            <image>
                <Image url="@../images/livros.png"/>
            </image>
        </ImageView>
    </VBox>
</HBox>